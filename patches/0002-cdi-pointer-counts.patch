+/* The CD-i's pointer port (cdislave_hle "MOUSEX"/"MOUSEY") ends up with an empty standard
+ * input sequence in this front end, so MAME never reads the mouse device for it and the
+ * mouse counts the front end supplies are lost; only the D-pad (a fixed 2 units per frame)
+ * moves the pointer. Hand the counts to those two ports directly instead: a programmatic
+ * value on an analog port is used as the frame's relative movement, in the same units
+ * (INPUT_RELATIVE_PER_PIXEL per count) that the mouse device would have delivered. */
+static void retro_push_cdi_pointer(running_machine &machine, int dx, int dy)
+{
+	static running_machine *cached = nullptr;
+	static ioport_port *port_x = nullptr, *port_y = nullptr;
+
+	if (cached != &machine)
+	{
+		cached = &machine;
+		port_x = port_y = nullptr;
+		for (auto &entry : machine.ioport().ports())
+		{
+			const std::string &tag = entry.first;
+			if (tag.find("slave") == std::string::npos || tag.size() < 7)
+				continue;
+			if (!tag.compare(tag.size() - 7, 7, ":MOUSEX"))
+				port_x = entry.second.get();
+			else if (!tag.compare(tag.size() - 7, 7, ":MOUSEY"))
+				port_y = entry.second.get();
+		}
+	}
+
+	if (port_x && dx)
+		for (ioport_field &field : port_x->fields())
+			field.set_value(dx * INPUT_RELATIVE_PER_PIXEL);
+	if (port_y && dy)
+		for (ioport_field &field : port_y->fields())
+			field.set_value(dy * INPUT_RELATIVE_PER_PIXEL);
+}
