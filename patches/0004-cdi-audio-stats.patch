--- a/src/devices/sound/dmadac.h
+++ b/src/devices/sound/dmadac.h
@@ -12,6 +12,23 @@
 
 #pragma once
 
+/* ps5-cdi: counters of what the CD-i's sound did, read (and the max reset) by the host for its log */
+enum
+{
+	CDI_AS_DRY,           /* the DAC ran out of samples part way through an update */
+	CDI_AS_DRY_SAMPLES,   /* the silent samples that followed */
+	CDI_AS_OVERRUN,       /* samples dropped: the DAC's buffer was full */
+	CDI_AS_MAP_SECTORS,   /* audio map (sound from memory) sectors played */
+	CDI_AS_DISC_SECTORS,  /* real-time audio sectors played from the disc */
+	CDI_AS_MAP_PREEMPTED, /* audio map playback stopped by a disc audio sector */
+	CDI_AS_MAP_STARTS,    /* audio map playback started by the program */
+	CDI_AS_MAX_LEVEL,     /* the most samples waiting in the DAC when a sector arrived */
+	CDI_AS_RATE_CHANGES,  /* sample rate changes */
+	CDI_AS_MAP_STOPS,     /* audio map playback ended */
+	CDI_AUDIO_STATS = 16
+};
+extern "C" { extern unsigned long cdi_audio_stats[CDI_AUDIO_STATS]; }
+
 
 class dmadac_sound_device : public device_t, public device_sound_interface
 {
@@ -40,10 +57,16 @@ public:
 				src += frame_spacing;
 			}
 			m_bufin = curin;
+
+			/* ps5-cdi: counted on the first DAC only */
+			if (m_counted && j != total_frames)
+				cdi_audio_stats[CDI_AS_OVERRUN] += total_frames - j;
 		}
 	}
 
 	void enable(uint8_t enable);
+	/* ps5-cdi: the samples waiting to be played */
+	u32 queued() const { return (m_bufin + BUFFER_SIZE - m_bufout) % BUFFER_SIZE; }
 	void set_frequency(double frequency);
 	void set_volume(uint16_t volume);
 
@@ -58,6 +81,8 @@ private:
 	// internal state
