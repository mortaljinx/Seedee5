 	sound_stream *  m_channel;
+	u32             m_stats_rate = 0;
+	bool            m_counted = false;
 	std::vector<stream_buffer::sample_t> m_buffer;
 	uint32_t          m_bufin;
 	uint32_t          m_bufout;
